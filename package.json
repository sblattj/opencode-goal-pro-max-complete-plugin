{
  "name": "opencode-goal-pro-max-complete-plugin",
  "version": "1.1.0",
  "description": "Durable, guarded goal workflows for OpenCode.",
  "type": "module",
  "main": "./dist/goal-plugin.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/goal-plugin.js",
      "default": "./dist/goal-plugin.js"
    },
    "./server": {
      "types": "./index.d.ts",
      "import": "./dist/goal-plugin.js",
      "default": "./dist/goal-plugin.js"
    },
    "./tui": {
      "types": "./tui.d.ts",
      "import": "./dist/goal-tui.js",
      "default": "./dist/goal-tui.js"
    }
  },
  "bin": {
    "opencode-goal-pro-max-complete-plugin": "./scripts/cli.mjs"
  },
  "files": [
    "dist",
    "src",
    "scripts/cli.mjs",
    "scripts/install.mjs",
    "scripts/verify.mjs",
    "skills",
    "install.sh",
    "examples",
    "demo",
    "docs",
    "index.d.ts",
    "tui.d.ts",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE",
    ".nvmrc"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:model": "node --test test/lifecycle-model.test.js",
    "test:mutation": "node scripts/mutation-contract.mjs",
    "test:coverage": "node --test --experimental-test-coverage test/*.test.js",
    "type:check": "node scripts/type-contract.mjs",
    "smoke": "node scripts/smoke-command-hook.mjs",
    "smoke:packed-host": "node scripts/packed-host-contract.mjs",
    "smoke:packed-tools": "node scripts/packed-tool-contract.mjs",
    "smoke:packed-manifest": "node scripts/packed-manifest-contract.mjs",
    "smoke:git-install": "node scripts/git-install-contract.mjs",
    "smoke:todo-mirror": "node scripts/smoke-todo-mirror.mjs",
    "smoke:todo-safety": "node scripts/smoke-todo-safety.mjs",
    "benchmark:behavior": "node scripts/behavior-benchmark.mjs",
    "benchmark:todo-mirror": "node scripts/bench-todo-mirror.mjs",
    "verify": "node scripts/verify.mjs",
    "installer": "node scripts/cli.mjs",
    "check": "node -c src/goal-plugin.js && node -c src/goal-tui.js && node -c src/goal-sidebar-view.js && node -c src/goal-format.js && npm test",
    "bundle": "npm run bundle:server && npm run bundle:tui",
    "bundle:server": "bun build ./src/goal-plugin.js --outfile ./dist/goal-plugin.js --target node",
    "bundle:tui": "bun build ./src/goal-tui.js --outfile ./dist/goal-tui.js --target node --packages external",
    "pack:check": "npm pack --dry-run",
    "release:check": "npm run bundle && npm run check && npm run test:coverage && npm run type:check && npm run test:mutation && npm run benchmark:behavior && npm run benchmark:todo-mirror && npm run smoke && npm run smoke:packed-host && npm run smoke:packed-tools && npm run smoke:packed-manifest && npm run smoke:git-install && npm run verify && npm audit --omit=dev --audit-level=high && npm run pack:check"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "agent",
    "goal"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18",
    "opencode": ">=1.17.15 <3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sblattj/opencode-goal-pro-max-complete-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/sblattj/opencode-goal-pro-max-complete-plugin/issues"
  },
  "homepage": "https://github.com/sblattj/opencode-goal-pro-max-complete-plugin#readme",
  "author": {
    "name": "Stephen Blatt"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "dependencies": {
    "zod": "4.6.5"
  }
}
