{
  "name": "opencode-goal-pro-max-complete-plugin",
  "version": "1.5.1",
  "description": "Durable, guarded goal workflows for OpenCode.",
  "type": "module",
  "main": "./dist/goal-plugin.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/goal-plugin.js",
      "default": "./dist/goal-plugin.js"
    },
    "./server": {
      "types": "./index.d.ts",
      "import": "./dist/goal-plugin.js",
      "default": "./dist/goal-plugin.js"
    },
    "./tui": {
      "types": "./tui.d.ts",
      "import": "./dist/goal-tui.js",
      "default": "./dist/goal-tui.js"
    }
  },
  "bin": {
    "opencode-goal-pro-max-complete-plugin": "./scripts/cli.mjs"
  },
  "files": [
    "dist",
    "src",
    "scripts/cli.mjs",
    "scripts/install.mjs",
    "scripts/verify.mjs",
    "skills",
    "install.sh",
    "examples",
    "demo",
    "docs",
    "index.d.ts",
    "tui.d.ts",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE",
    ".nvmrc"
  ],
  "scripts": {
    "test": "bun test --timeout 30000 test/*.test.js",
    "test:model": "bun test --timeout 30000 test/lifecycle-model.test.js",
    "test:installer": "node --test test/installer-cli.test.js test/bootstrap-dispatch.test.js",
    "test:mutation": "bun scripts/mutation-contract.mjs",
    "test:coverage": "bun test --timeout 30000 --coverage test/*.test.js",
    "type:check": "node scripts/type-contract.mjs",
    "smoke": "bun scripts/smoke-command-hook.mjs",
    "smoke:packed-host": "node scripts/packed-host-contract.mjs",
    "smoke:packed-tools": "node scripts/packed-tool-contract.mjs",
    "smoke:packed-manifest": "node scripts/packed-manifest-contract.mjs",
    "smoke:git-install": "node scripts/git-install-contract.mjs",
    "smoke:todo-mirror": "bun scripts/smoke-todo-mirror.mjs",
    "smoke:forced-compaction": "bun scripts/smoke-forced-compaction.mjs",
    "smoke:todo-safety": "bun scripts/smoke-todo-safety.mjs",
    "smoke:multi-process": "bun scripts/multi-process-contract.mjs",
    "benchmark:behavior": "bun scripts/behavior-benchmark.mjs",
    "benchmark:todo-mirror": "bun scripts/bench-todo-mirror.mjs",
    "verify": "bun scripts/verify.mjs",
    "installer": "node scripts/cli.mjs",
    "check": "bun scripts/check-syntax.mjs src/goal-plugin.js src/goal-tui.js src/goal-sidebar-view.js src/goal-format.js && bun run test",
    "bundle": "bun run bundle:server && bun run bundle:tui",
    "bundle:server": "bun build ./src/goal-plugin.js --outfile ./dist/goal-plugin.js --target node",
    "bundle:tui": "bun build ./src/goal-tui.js --outfile ./dist/goal-tui.js --target node --packages external",
    "pack:check": "npm pack --dry-run",
    "release:check": "bun run bundle && bun run check && bun run test:installer && bun run test:coverage && bun run type:check && bun run test:mutation && bun run benchmark:behavior && bun run benchmark:todo-mirror && bun run smoke && bun run smoke:packed-host && bun run smoke:packed-tools && bun run smoke:packed-manifest && bun run smoke:git-install && bun run verify && bun audit --prod --audit-level=high && bun run pack:check"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "agent",
    "goal"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18",
    "opencode": ">=1.17.15 <3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sblattj/opencode-goal-pro-max-complete-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/sblattj/opencode-goal-pro-max-complete-plugin/issues"
  },
  "homepage": "https://github.com/sblattj/opencode-goal-pro-max-complete-plugin#readme",
  "author": {
    "name": "Stephen Blatt"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
